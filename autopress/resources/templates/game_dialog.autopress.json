{
  "schema_version": 1,
  "id": "template-game-dialog",
  "name": "遊戲內兌換視窗（通用）",
  "game": "",
  "description": "適用遊戲裡的「兌換碼」視窗：先在遊戲裡打開兌換視窗再開始。以遊戲模式（按鍵碼）輸入；建議在「輸入序號」步驟設定核對範圍，確認遊戲收到的字正確。建立後在「遊戲」欄填上遊戲名稱。",
  "author": "AutoPress",
  "target": {
    "exe": "",
    "title": "",
    "title_mode": "contains",
    "class_name": "",
    "allow_same_process": false
  },
  "suggested_exe": "",
  "coord_mode": "auto",
  "code_format": {
    "id": "generic",
    "charset": "A-Za-z0-9",
    "case_sensitive": true,
    "min_len": 6,
    "max_len": 24,
    "groups": [],
    "separator": "-",
    "regex": ""
  },
  "steps": [
    {
      "type": "wait_text",
      "params": {
        "text": "兌換|兑换|序號|序号|禮包|礼包|Redeem|Code|コード",
        "match": "contains",
        "region": null,
        "appear": true,
        "timeout_ms": 5000,
        "poll_ms": 500,
        "on_timeout": "fail"
      },
      "enabled": true,
      "label": "確認遊戲的兌換視窗已開啟",
      "label_en": "Check that the game's redeem dialog is open",
      "id": "tpl-game-1"
    },
    {
      "type": "click_point",
      "params": {
        "point": null,
        "button": "left",
        "double": false,
        "after_ms": 150
      },
      "enabled": true,
      "label": "點一下序號輸入框",
      "label_en": "Click the code input box",
      "id": "tpl-game-2"
    },
    {
      "type": "type_code",
      "params": {
        "mode": "vk",
        "key_delay_ms": 30,
        "hold_ms": 30,
        "clear_first": true,
        "clear_method": "ctrl_a",
        "split": "none",
        "after_ms": 150
      },
      "enabled": true,
      "label": "輸入序號（遊戲模式）",
      "label_en": "Type the code (game mode)",
      "id": "tpl-game-3"
    },
    {
      "type": "click_text",
      "params": {
        "text": "確認|确认|確定|确定|兌換|兑换|領取|领取|Confirm|OK|Redeem|Claim",
        "match": "exact",
        "region": null,
        "timeout_ms": 3000,
        "poll_ms": 500,
        "on_not_found": "fail",
        "after_ms": 150
      },
      "enabled": true,
      "label": "按下「確認」或「兌換」按鈕",
      "label_en": "Press the Confirm or Redeem button",
      "id": "tpl-game-4"
    },
    {
      "type": "ocr_check",
      "params": {
        "region": null,
        "initial_delay_ms": 800,
        "timeout_ms": 5000,
        "poll_ms": 500,
        "save_evidence": true,
        "only_new_text": true
      },
      "enabled": true,
      "label": "拉出結果訊息出現的範圍",
      "label_en": "Drag over the area where the result message appears",
      "id": "tpl-game-5"
    },
    {
      "type": "click_text",
      "params": {
        "text": "確定|确定|OK|關閉|关闭|Close|領取|领取",
        "match": "exact",
        "region": null,
        "timeout_ms": 1500,
        "poll_ms": 500,
        "on_not_found": "continue",
        "after_ms": 300
      },
      "enabled": true,
      "label": "關閉結果視窗（沒有就略過）",
      "label_en": "Close the result popup (skipped if there is none)",
      "id": "tpl-game-6"
    }
  ],
  "template": {
    "key": "game_dialog",
    "title_zh": "遊戲內兌換視窗（通用）",
    "title_en": "In-game redeem dialog (generic)",
    "description_zh": "適用遊戲裡的「兌換碼」視窗：先在遊戲裡打開兌換視窗再開始。以遊戲模式（按鍵碼）輸入；建議在「輸入序號」步驟設定核對範圍，確認遊戲收到的字正確。建立後在「遊戲」欄填上遊戲名稱。",
    "description_en": "For a redeem-code dialog inside a game: open the dialog in the game before you start. Types in game mode (key codes); setting a verify region on the \"Type code\" step is recommended to check what the game received. After creating it, enter the game name.",
    "order": 30
  },
